# The Usher registry: HTTP API, front page, dashboard, map viewer, and the MCP server for agents to run.
# Two stages: the build makes the site script and middleware bundles; the runtime has production
# dependencies only, and Chromium's headless shell (not the full browser set) for the viewer.

FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/registry/package.json packages/registry/
COPY packages/site-middleware/package.json packages/site-middleware/
COPY packages/site-script/package.json packages/site-script/
COPY packages/agent/package.json packages/agent/
COPY packages/mcp/package.json packages/mcp/
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY spec spec
COPY packages packages
COPY scripts scripts
RUN npm run build

FROM node:20-bookworm-slim
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/registry/package.json packages/registry/
COPY packages/site-middleware/package.json packages/site-middleware/
COPY packages/site-script/package.json packages/site-script/
COPY packages/agent/package.json packages/agent/
COPY packages/mcp/package.json packages/mcp/
# Chromium's system libraries need root; the server itself runs as the node user.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npx playwright install --with-deps --only-shell chromium \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/* /root/.cache
COPY spec spec
COPY reports reports
# train.py and its requirements, which the registry sends to a retraining job (USHER_AUTO_TRAIN).
COPY deploy/finetune/train.py deploy/finetune/requirements.txt deploy/finetune/
COPY packages packages
COPY --from=build /app/packages/site-script/dist packages/site-script/dist
COPY --from=build /app/packages/site-middleware/dist packages/site-middleware/dist
# The compiler log and file store write under /app/data.
RUN mkdir -p /app/data && chown node:node /app/data

# The git SHA this image was built from, for /status (scripts/ecr-push.sh passes it).
ARG USHER_VERSION=dev
ENV HOST=0.0.0.0 PORT=4200 NODE_OPTIONS=--disable-warning=ExperimentalWarning USHER_VERSION=$USHER_VERSION
EXPOSE 4200
USER node
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD node -e "fetch('http://'+require('os').hostname()+':'+process.env.PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Migrations: node --import tsx packages/registry/scripts/db.ts migrate
# The MCP server runs where the agent is (it holds the agent's key):
#   docker run -i --rm -e USHER_REGISTRY_URL=https://registry.example -v ~/.usher:/home/node/.usher <image> node --import tsx packages/registry/src/mcp.ts
CMD ["node", "--import", "tsx", "packages/registry/src/server.ts"]
