{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhys-looma/usher/spec/plan.schema.json",
  "title": "Usher plan",
  "type": "object",
  "required": [
    "usher_plan",
    "origin",
    "intent",
    "start",
    "steps",
    "inputs",
    "consequential",
    "complete",
    "stops_at"
  ],
  "additionalProperties": false,
  "properties": {
    "usher_plan": {
      "const": "0.1"
    },
    "origin": {
      "type": "string",
      "pattern": "^https?://[^/]+$"
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "type": "string",
      "pattern": "^/"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "map",
          "purpose",
          "advance",
          "leads_to"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "map": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "purpose": {
            "type": "string"
          },
          "advance": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "key",
                  "label",
                  "risk"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "key": {
                    "$ref": "#/$defs/key"
                  },
                  "label": {
                    "type": "string"
                  },
                  "risk": {
                    "$ref": "#/$defs/risk"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "leads_to": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "control",
          "required",
          "risk",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "risk": {
            "$ref": "#/$defs/risk"
          },
          "sensitive": {
            "type": "boolean"
          },
          "rule": {
            "enum": [
              "allow",
              "confirm",
              "forbid"
            ]
          },
          "constraints": {
            "type": "object"
          },
          "options": {
            "type": "object",
            "required": [
              "items",
              "total",
              "truncated"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "total": {
                "type": "integer"
              },
              "truncated": {
                "type": "boolean"
              }
            }
          },
          "shown_if": {
            "type": "object"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "consequential": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "key",
          "label",
          "risk"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "type": "string"
          },
          "risk": {
            "$ref": "#/$defs/risk"
          }
        }
      }
    },
    "lookups": {
      "type": "array",
      "description": "Lookup actions on the way (lookup.vehicle, lookup.address): an agent runs them before filling the fields they fill.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "key",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "resume": {
      "description": "Optional: how the person picks the journey's result up on the site afterwards. The site's own page for it, what it asks the person (in words), and the query parameter, if any, that prefills the reference.",
      "type": "object",
      "required": [
        "url",
        "label",
        "asks"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "maxLength": 200,
          "description": "A path on the plan's origin."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "asks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "reference_param": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "stops_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "risk": {
      "enum": [
        "safe",
        "consequential",
        "needs_user"
      ]
    }
  }
}
