{
  "name": "usher",
  "private": true,
  "description": "Open protocol and script tag that lets websites control AI agents on their forms.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build && playwright install chromium",
    "test": "node scripts/test.mjs",
    "og-image": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/og-image.ts",
    "check:urls": "node scripts/check-urls.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vocabulary": "tsx packages/core/scripts/build-vocabulary.ts",
    "compile": "tsx packages/core/src/compile/cli.ts",
    "fixtures:record": "node scripts/record-fixtures.mjs && node --disable-warning=ExperimentalWarning --import tsx packages/mcp/scripts/record-details.ts",
    "sites": "node examples/sites/server.mjs",
    "registry": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/src/server.ts",
    "seed:build": "node scripts/with-mock-sites.mjs node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/build-seed.ts",
    "agent": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/src/cli.ts",
    "fixtures:record:open": "node scripts/record-fixtures.mjs --open",
    "fixtures:record:forms": "node scripts/with-mock-sites.mjs node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/record-form-choices.ts",
    "keygen": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/keygen.ts",
    "db": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/db.ts",
    "e2e:remote": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/e2e-remote.ts",
    "accuracy": "node scripts/with-mock-sites.mjs node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/accuracy.ts",
    "accuracy:score": "node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/accuracy-score.ts",
    "demo": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/live/demo.ts",
    "demo:local": "USHER_DEMO=1 node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/demo/demo.ts",
    "demo:walkthrough": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/walkthrough-demo.ts",
    "demo:drift": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/drift-demo.ts",
    "finetune:export": "node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/finetune-export.ts",
    "finetune:train": "node scripts/finetune.mjs train",
    "finetune:status": "node scripts/finetune.mjs status",
    "finetune:serve": "node scripts/finetune.mjs serve",
    "finetune:stop": "node scripts/finetune.mjs stop",
    "finetune:eval": "node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/finetune-eval.ts",
    "training:upload-base": "node scripts/training-upload-base.mjs",
    "maps:import": "node scripts/maps-import.mjs",
    "keys:disagreements": "node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/key-disagreements.ts",
    "benchmark": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/benchmark.ts",
    "dryrun": "node scripts/dryrun/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vue": "^3.5.13"
  }
}
