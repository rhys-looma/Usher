{
  "name": "usher",
  "private": true,
  "description": "Open protocol and script tag that lets websites control AI agents on their forms.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build && playwright install chromium",
    "test": "node scripts/test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vocabulary": "tsx packages/core/scripts/build-vocabulary.ts",
    "compile": "tsx packages/core/src/compile/cli.ts",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "registry": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/src/server.ts",
    "seed:build": "node scripts/with-mock-sites.mjs node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/build-seed.ts",
    "agent": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/src/cli.ts",
    "fixtures:record:open": "node scripts/record-fixtures.mjs --open",
    "keygen": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/keygen.ts",
    "db": "node --disable-warning=ExperimentalWarning --import tsx packages/registry/scripts/db.ts",
    "e2e:remote": "node --disable-warning=ExperimentalWarning --import tsx packages/agent/scripts/e2e-remote.ts",
    "accuracy": "node scripts/with-mock-sites.mjs node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/accuracy.ts",
    "accuracy:score": "node --disable-warning=ExperimentalWarning --import tsx packages/core/scripts/accuracy-score.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
