# Copy to deploy/ecs/config.env (gitignored) and fill in from what you created in AWS (DEPLOY.md).
# Read by scripts/ecr-push.sh, scripts/ecs-deploy.sh, scripts/ecs-migrate.sh and scripts/db-backup.sh.

AWS_ACCOUNT_ID=111111111111
AWS_REGION=eu-west-2

# ECR repositories (tag mutability: mutable, since :latest moves).
REGISTRY_REPO=usher-registry
SITE_REPO=usher-mock-site

# Hosts, without https://.
REGISTRY_HOST=registry.example
SITE_HOST=quote.registry.example

# ECS.
ECS_CLUSTER=my-cluster
REGISTRY_SERVICE=usher-registry
SITE_SERVICE=usher-mock-site
EXECUTION_ROLE_ARN=arn:aws:iam::111111111111:role/usher-execution
TASK_ROLE_ARN=arn:aws:iam::111111111111:role/usher-task
# For the one-off migrate task: the registry service's subnets and security group.
TASK_SUBNETS=subnet-aaaa,subnet-bbbb
TASK_SECURITY_GROUP=sg-0123456789abcdef0
ASSIGN_PUBLIC_IP=DISABLED

# Secrets Manager: secrets named <prefix>/DATABASE_URL and so on. Their ARNs are looked up at render
# time; set SECRET_ARN_<NAME> to give one directly.
SECRET_PREFIX=usher

# Application settings.
CONTACT_EMAIL=hello@registry.example
DAILY_MODEL_BUDGET_USD=5
# The demo site's public site key, from /sites/new. Empty until it is registered.
MOCK_SITE_KEY=
# The demo sites (examples/sites): their service, and which sites it serves (empty: none).
DEMO_SITES_SERVICE=usher-demo-sites
DEMO_SITES=
