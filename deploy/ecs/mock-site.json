{
  "family": "usher-mock-site",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "mock-site",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${SITE_REPO}:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [{ "containerPort": 4100, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4100" },
        { "name": "USHER_REGISTRY_URL", "value": "https://${REGISTRY_HOST}" },
        { "name": "USHER_SITE_ORIGIN", "value": "https://${SITE_HOST}" },
        { "name": "USHER_SITE_KEY", "value": "${MOCK_SITE_KEY}" }
      ],
      "secrets": [
        { "name": "USHER_ADMIN_KEY", "valueFrom": "${SECRET_ARN_USHER_ADMIN_KEY}" }
      ],
      "healthCheck": {
        "command": ["CMD", "node", "-e", "fetch('http://'+require('os').hostname()+':4100/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": { "awslogs-group": "/ecs/usher-mock-site", "awslogs-region": "${AWS_REGION}", "awslogs-stream-prefix": "mock-site" }
      }
    }
  ]
}
