# Copy to .env (gitignored). Neither is needed to run Usher on your machine: without them, the demo
# maps and the recorded model answers do the work. Add them to build new maps or explain sessions.

# Meta Model API, for Muse Spark: compiling maps, rules in plain English, explaining sessions.
MODEL_API_KEY=

# Baseten, for Muse Spark Open: the second opinion on risk, and the second agent.
BASETEN_API_KEY=
